      ],
      "id": "f3985474-47ea-4b7c-ad12-de61afff12ea",
      "name": "LLM-Extraktion",
      "retryOnFail": true,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "sCtRJ9kvjhPjbLBz",
          "name": "Header Auth account 17"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Code-Node \"JSON pruefen\"  –  Mode: \"Run Once for Each Item\", Sprache: JavaScript\n// Liest die OpenRouter-Antwort, prueft sie gegen das erwartete Schema\n// und fuehrt sie mit den Formulardaten zusammen.\n\nconst KATEGORIEN = ['Ladestation', 'HV-Batteriepack', 'E-Bike-Akku', 'Onboard-Ladegeraet', 'Sonstiges'];\nconst MAERKTE = ['EU', 'USA', 'Global'];\n\nconst eingang = $('Anfrage vorbereiten').item.json;   // Daten aus dem Formular\nconst antwort = $json;                                  // Antwort von OpenRouter\nconst usage = antwort.usage || {};\nconst llmText = antwort.choices?.[0]?.message?.content ?? '';\n\nconst fehler = [];\nlet daten = null;\n\n// 1. JSON lesen (eventuelle ```json-Zaeune entfernen)\ntry {\n  const bereinigt = llmText.replace(/```json|```/g, '').trim();\n  daten = JSON.parse(bereinigt);\n} catch (e) {\n  fehler.push('LLM-Antwort ist kein gueltiges JSON');\n}\n\n// 2. Schema pruefen\nif (daten) {\n  if (typeof daten.ist_pruefanfrage !== 'boolean') {\n    fehler.push('ist_pruefanfrage fehlt oder ist kein true/false');\n  }\n  if (!KATEGORIEN.includes(daten.produktkategorie)) {\n    fehler.push(`Unbekannte Produktkategorie: ${daten.produktkategorie}`);\n  }\n  if (!Array.isArray(daten.zielmaerkte)) {\n    fehler.push('zielmaerkte ist keine Liste');\n  } else if (daten.zielmaerkte.some(m => !MAERKTE.includes(m))) {\n    fehler.push(`Unbekannter Zielmarkt in: ${daten.zielmaerkte.join(', ')}`);\n  }\n  if (!Array.isArray(daten.fehlende_angaben)) {\n    fehler.push('fehlende_angaben ist keine Liste');\n  }\n}\n\nconst jsonOk = fehler.length === 0;\n\n// 3. Pflichtangaben absichern, auch wenn das LLM sie nicht gemeldet hat\nif (jsonOk && daten.ist_pruefanfrage && daten.zielmaerkte.length === 0\n    && !daten.fehlende_angaben.includes('Zielmarkt')) {\n  daten.fehlende_angaben.push('Zielmarkt');\n}\n\n// 4. Status bestimmen\nlet status;\nif (!jsonOk) status = 'Manuelle Pruefung';\nelse if (!daten.ist_pruefanfrage) status = 'Aussortiert';\nelse if (daten.fehlende_angaben.length > 0) status = 'Rueckfrage';\nelse status = 'In Bearbeitung';\n\nreturn {\n  json: {\n    // aus dem Formular\n    firma: eingang.firma,\n    ansprechpartner: eingang.ansprechpartner,\n    email: eingang.email,\n    rohtext: eingang.rohtext,\n    startzeit: eingang.startzeit,\n    // aus dem LLM\n    ist_pruefanfrage: daten?.ist_pruefanfrage ?? null,\n    produktkategorie: daten?.produktkategorie ?? null,\n    produktbeschreibung: daten?.produktbeschreibung ?? null,\n    zielmaerkte: daten?.zielmaerkte ?? [],\n    stueckzahl_prototypen: daten?.stueckzahl_prototypen ?? null,\n    wunschtermin: daten?.wunschtermin ?? null,\n    sprache: daten?.sprache ?? 'de',\n    fehlende_angaben: daten?.fehlende_angaben ?? [],\n    // Pruefergebnis und Kosten\n    json_ok: jsonOk,\n    validierungsfehler: fehler,\n    status: status,\n    llm_rohantwort: llmText,\n    modell: antwort.model ?? null,\n    token_input: usage.prompt_tokens ?? 0,\n    token_output: usage.completion_tokens ?? 0,\n    kosten_usd: usage.cost ?? null,\n  },\n};"
      },
