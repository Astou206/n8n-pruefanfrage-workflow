    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Code-Node \"Angebot-Prompt bauen\"  –  Mode: \"Run Once for Each Item\", JavaScript\n// Baut den kompletten Request fuer OpenRouter als Objekt.\n// Der HTTP-Node muss dann nur noch {{ JSON.stringify($json.request_body) }} senden.\n\nconst d = $json;\nconst summe = Number(d.angebotssumme_eur || 0).toLocaleString('de-DE');\nconst maerkte = Array.isArray(d.zielmaerkte) ? d.zielmaerkte.join(', ') : '';\n\nconst systemPrompt =\n  'Du schreibst im Namen des Vertriebs einer Prüf- und Zertifizierungsorganisation ' +\n  'einen kurzen, sachlichen Angebotsentwurf als Antwort auf eine Kundenanfrage. ' +\n  'Schreibe in der Sprache der Anfrage (de = Deutsch, en = Englisch). ' +\n  'Aufbau: Anrede, ein Satz Dank für die Anfrage mit Bezug zum Produkt, ' +\n  'die Prüfleistungen als nummerierte Liste mit Regelwerk und Preis, die Gesamtsumme netto, ' +\n  'ein Satz zum Wunschtermin falls vorhanden, Grußformel \"Ihr Vertriebsteam\". ' +\n  'Verwende ausschließlich die gelieferten Positionen und Preise und erfinde nichts dazu. ' +\n  'Beende den Text mit dem Satz: \"Dies ist ein unverbindlicher Angebotsentwurf und wird vor Versand fachlich geprüft.\" ' +\n  'Gib nur den Text zurück, ohne Markdown.';\n\nconst userPrompt = [\n  `Firma: ${d.firma}`,\n  `Ansprechpartner: ${d.ansprechpartner || 'unbekannt'}`,\n  `Sprache: ${d.sprache || 'de'}`,\n  `Produkt: ${d.produktbeschreibung || ''}`,\n  `Zielmärkte: ${maerkte}`,\n  `Wunschtermin: ${d.wunschtermin || 'keiner'}`,\n  '',\n  'Positionen:',\n  d.positionen_text || '',\n  '',\n  `Gesamtsumme: ${summe} EUR netto`,\n].join('\\n');\n\nreturn {\n  json: {\n    ...d,\n    request_body: {\n      model: 'openai/gpt-4o-mini',\n      temperature: 0.3,\n      messages: [\n        { role: 'system', content: systemPrompt },\n        { role: 'user', content: userPrompt },\n      ],\n    },\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        912,
        -528
      ],
      "id": "8be585d6-2404-47fa-8b79-c6d843b577f3",
      "name": "Angebot-Prompt bauen"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Code-Node \"Angebot zusammenfuehren\"  –  Mode: \"Run Once for Each Item\", JavaScript\n// Fuehrt den Angebotstext mit den Anfragedaten zusammen, summiert Tokens und\n// Kosten beider LLM-Aufrufe und misst die Laufzeit seit Formulareingang.\n\nconst d = $('Preis berechnen').item.json;   // Anfrage + Positionen + Preis\nconst r = $json;                              // Antwort von OpenRouter (Angebotstext)\nconst usage = r.usage || {};\nconst text = (r.choices?.[0]?.message?.content ?? '').trim();\n\nconst laufzeit = (Date.now() - new Date(d.startzeit).getTime()) / 1000;\n\nreturn {\n  json: {\n    ...d,\n    angebotstext: text,\n    status: text ? 'Angebot erstellt' : 'Manuelle Pruefung',\n    token_input: (d.token_input || 0) + (usage.prompt_tokens || 0),\n    token_output: (d.token_output || 0) + (usage.completion_tokens || 0),\n    kosten_usd: Number(((d.kosten_usd || 0) + (usage.cost || 0)).toFixed(6)),\n    laufzeit_s: Math.round(laufzeit * 10) / 10,\n  },\n};"
      },
