    {
      "parameters": {
        "jsCode": "// Code-Node \"Preis berechnen\"  –  Mode: \"Run Once for All Items\", Sprache: JavaScript\n// Nimmt alle Katalogzeilen aus Supabase, berechnet den Angebotspreis\n// und fuehrt alles zu EINEM Item mit den Anfragedaten zusammen.\n\nconst anfrage = $('JSON prüfen').first().json;   // extrahierte Anfragedaten\n\n// Leere Items aussortieren (kommen, wenn Supabase 0 Zeilen liefert)\nconst zeilen = $input.all()\n  .map(item => item.json)\n  .filter(z => z && z.id !== undefined);\n\nconst positionen = zeilen.map(z => {\n  const stunden = Number(z.pruefstunden) || 0;\n  const satz = Number(z.stundensatz_eur) || 0;\n  const pauschale = Number(z.pauschale_eur) || 0;\n  return {\n    zielmarkt: z.zielmarkt,\n    pruefleistung: z.pruefleistung,\n    regelwerk: z.regelwerk,\n    pruefstunden: stunden,\n    stundensatz_eur: satz,\n    pauschale_eur: pauschale,\n    summe_eur: stunden * satz + pauschale,\n  };\n});\n\nconst summeStunden = positionen.reduce((s, p) => s + p.pruefstunden, 0);\nconst summeEur = positionen.reduce((s, p) => s + p.summe_eur, 0);\nconst treffer = positionen.length;\n\n// Lesbare Positionsliste fuer den Angebotstext\nconst positionenText = positionen\n  .map((p, i) => `${i + 1}. ${p.pruefleistung} (${p.regelwerk}, ${p.zielmarkt}): ${p.pruefstunden} h, ${p.summe_eur.toLocaleString('de-DE')} EUR`)\n  .join('\\n');\n\nreturn [{\n  json: {\n    ...anfrage,\n    status: treffer > 0 ? 'In Bearbeitung' : 'Kein Katalogtreffer',\n    treffer: treffer,\n    positionen: positionen,\n    positionen_text: positionenText,\n    summe_stunden: summeStunden,\n    angebotssumme_eur: summeEur,\n  },\n}];"
      },
