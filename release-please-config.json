        { "type": "ci", "section": "Technische Änderungen" },
        { "type": "docs", "section": "Dokumentation" },
        { "type": "test", "section": "Tests" },
        { "type": "revert", "section": "Rücknahmen" },
        { "type": "chore", "section": "Sonstiges", "hidden": true },
        { "type": "style", "section": "Formatierung", "hidden": true }
      ]
    }
  }
